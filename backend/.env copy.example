NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Neon PostgreSQL
DATABASE_HOST=your-neon-host.neon.tech
DATABASE_PORT=5432
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=neondb
DATABASE_SSL=true

# Firebase Admin (prefer service account JSON path for local)
FIREBASE_PROJECT_ID=unsung-harvest
FIREBASE_SERVICE_ACCOUNT_PATH=./unsung-harvest-firebase-adminsdk-fbsvc-3ce27e0c5c.json
# Or set these instead of the JSON path:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@unsung-harvest.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_DEST=./uploads

# Vercel Blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# App
APP_NAME=Unsung Harvest
APP_URL=http://localhost:3001


